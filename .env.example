# ── CAPTCHA ──
# Fallback Claude Vision hanya dipakai jika OpenCV gagal DAN ini diaktifkan.
# Default: OpenCV otomatis saja (tanpa Claude).
USE_CLAUDE_FALLBACK=0
ANTHROPIC_API_KEY=

# ── Login pangkalan (opsional untuk mode standalone/testing) ──
# Di dashboard, telepon/password diambil dari data pangkalan (pangkalan_config.json),
# bukan dari sini. Variabel di bawah hanya untuk skrip test lama.
PANGKALAN_1_PHONE=
PANGKALAN_1_PASSWORD=
